# JMJ Enterprise Solutions - Workforce Management & Field Operations
# Environment Configuration Template (Safe for Version Control)
# Copy this file to .env and configure values for your environment

APP_NAME="JMJ Workforce & Operations Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.jmjenterprisessolutions.com
APP_KEY=replace_with_a_secure_random_64_character_key
APP_TIMEZONE=Asia/Kolkata

# Dedicated Workforce Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jmj_workforce_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_password

# Session Security
SESSION_LIFETIME=28800
SESSION_SECURE=true

# Geofence & Verification Parameters
DEFAULT_GEOFENCE_RADIUS=75 # meters
QR_TOKEN_LIFETIME=30 # seconds
FACE_DATA_RETENTION_DAYS=90
NO_SHOW_GRACE_MINUTES=30
PATROL_TOLERANCE_MINUTES=15

# Dispatch & Emergency Hotline
EMERGENCY_SOS_HOTLINE="18008890832"
OPERATIONS_COMMAND_PHONE="+91-9999381777"
OPERATIONS_EMAIL="ops@jmjenterprisessolutions.com"

# Provider Integrations (Pluggable)
FACE_VERIFICATION_PROVIDER=mock_local # mock_local, aws_rekognition, azure_face
NOTIFICATION_PROVIDER=in_app # in_app, whatsapp_cloud_api, twilio_sms
